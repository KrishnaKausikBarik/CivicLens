# Local-development example only. Production configuration belongs in Vercel Project Settings.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-Werkzeug-password-hash
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
