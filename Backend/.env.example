# Local-development example only. Production configuration belongs in Vercel Project Settings.
# For Vercel, use the shared Supabase Session pooler URL from Connect.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-Werkzeug-password-hash
FRONTEND_URL=http://127.0.0.1:5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_SENDER_EMAIL=your-address@gmail.com
SMTP_SENDER_NAME=CivicLens
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
