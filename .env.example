# Set these in the local environment or Vercel Project Settings. Never commit real values.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-Werkzeug-password-hash
